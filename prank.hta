<html>
<head>
<title>System Message</title>
<hta:application 
    id="oHTA"
    applicationname="SmoothRunaway"
    border="dialog"
    caption="yes"
    maximizebutton="no"
    minimizebutton="no"
    scroll="no"
    showintaskbar="yes"
    singleinstance="yes"
    sysmenu="yes">

<style>
    body {
        background-color: #F1EFEA; /* Classic Windows XP Luna color */
        font-family: "Tahoma", sans-serif;
        font-size: 8pt;
        margin: 0px;
        overflow: hidden;
    }
    #errorText {
        position: absolute;
        top: 30px;
        left: 20px;
        width: 260px;
        text-align: center;
    }
</style>

<script language="VBScript">
   
    Dim targetX, targetY, currentX, currentY, isMoving
    isMoving = False

    Sub Window_OnLoad
       
        window.resizeTo 300, 140
        currentX = (screen.width - 300) / 2
        currentY = (screen.height - 140) / 2
        window.moveTo currentX, currentY
    End Sub

 
    Sub HandleMouseMove
      
        If isMoving Then Exit Sub
        
        
        Randomize
        targetX = Int(((screen.width - 320) * Rnd) + 1)
        targetY = Int(((screen.height - 160) * Rnd) + 1)
        
        isMoving = True
        SmoothSlide
    End Sub

  
    Sub SmoothSlide
        Dim stepX, stepY, distX, distY, speed
        speed = 15 ' Higher number = faster movement
        
    
        distX = targetX - currentX
        distY = targetY - currentY
        
     
        If Abs(distX) < speed And Abs(distY) < speed Then
            currentX = targetX
            currentY = targetY
            window.moveTo currentX, currentY
            isMoving = False
            Exit Sub
        End If
        
      
        stepX = distX / 6
        stepY = distY / 6
        
        
        currentX = currentX + stepX
        currentY = currentY + stepY
        
       
        window.moveTo currentX, currentY
        
       
        window.setTimeout "SmoothSlide", 10, "VBScript"
    End Sub
</script>
</head>


<body onmousemove="HandleMouseMove">
    <div id="errorText">Updating system configuration... Please wait.</div>
</body>
</html>
